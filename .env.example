# ─────────────────────────────────────────────────────────────
# PaceMate2 — Variables d'environnement
# Copie ce fichier en .env.local et remplis chaque valeur.
# Ne commite JAMAIS .env.local dans git.
# ─────────────────────────────────────────────────────────────

# ── Supabase (obligatoire) ────────────────────────────────────
# Retrouve ces valeurs dans : Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Clé service-role (serveur uniquement — ne jamais exposer côté client)
# Retrouve-la dans : Supabase Dashboard → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Strava (obligatoire pour la sync d'activités) ─────────────
# Crée une app sur : https://www.strava.com/settings/api
NEXT_PUBLIC_STRAVA_CLIENT_ID=12345
STRAVA_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# URL de redirection après OAuth Strava (doit correspondre à l'app Strava)
# En local  : http://localhost:3000/api/strava/callback
# En prod   : https://tondomaine.com/api/strava/callback
NEXT_PUBLIC_STRAVA_REDIRECT_URI=http://localhost:3000/api/strava/callback

# ── Anthropic / Claude (obligatoire pour la vérification d'identité) ──
# Crée une clé sur : https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── SMS / Vérification téléphone ─────────────────────────────
# Activer le provider Phone dans Supabase → Auth → Providers → Phone
# Supabase gère le fournisseur SMS (Twilio, Vonage, etc.) directement
# Aucune variable supplémentaire n'est requise ici si tu utilises Twilio via Supabase

# ── Emails transactionnels — Resend (Sprint 3) ───────────────
# Crée un compte et une clé API sur : https://resend.com
# Vérifie ton domaine dans Resend pour envoyer depuis ton adresse
# Si absent, les emails sont silencieusement ignorés (non bloquant)
RESEND_API_KEY=re_...
EMAIL_FROM=PaceMate <noreply@tondomaine.com>

# URL publique du site (utilisée dans les liens des emails)
# En local  : http://localhost:3000
# En prod   : https://tondomaine.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Optionnel : monitoring (recommandé en production) ────────
# NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
# SENTRY_AUTH_TOKEN=...
