<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
         https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>PaceMate</display-name>
    <description>Trouve ton binôme running</description>

    <!-- Servlet de démarrage pour Hibernate -->
    <listener>
        <listener-class>com.pacemate.util.AppContextListener</listener-class>
    </listener>

    <!-- Filtre de thème (injecte le thème courant dans chaque requête) -->
    <filter>
        <filter-name>ThemeFilter</filter-name>
        <filter-class>com.pacemate.filter.ThemeFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>ThemeFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- Filtre encodage UTF-8 -->
    <filter>
        <filter-name>EncodingFilter</filter-name>
        <filter-class>com.pacemate.filter.EncodingFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>EncodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- Home -->
    <servlet>
        <servlet-name>HomeServlet</servlet-name>
        <servlet-class>com.pacemate.servlet.HomeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HomeServlet</servlet-name>
        <url-pattern>/</url-pattern>
    </servlet-mapping>

    <!-- Dashboard -->
    <servlet>
        <servlet-name>DashboardServlet</servlet-name>
        <servlet-class>com.pacemate.servlet.DashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DashboardServlet</servlet-name>
        <url-pattern>/dashboard</url-pattern>
    </servlet-mapping>

    <!-- Changement de thème -->
    <servlet>
        <servlet-name>ThemeServlet</servlet-name>
        <servlet-class>com.pacemate.servlet.ThemeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ThemeServlet</servlet-name>
        <url-pattern>/theme</url-pattern>
    </servlet-mapping>

    <!-- Inscription -->
    <servlet>
        <servlet-name>RegisterServlet</servlet-name>
        <servlet-class>com.pacemate.servlet.RegisterServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RegisterServlet</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>

    <!-- Connexion -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.pacemate.servlet.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <!-- Déconnexion -->
    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.pacemate.servlet.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <!-- Profil runner -->
    <servlet>
        <servlet-name>ProfileServlet</servlet-name>
        <servlet-class>com.pacemate.servlet.ProfileServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ProfileServlet</servlet-name>
        <url-pattern>/profile</url-pattern>
    </servlet-mapping>

    <!-- Matching -->
    <servlet>
        <servlet-name>MatchServlet</servlet-name>
        <servlet-class>com.pacemate.servlet.MatchServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MatchServlet</servlet-name>
        <url-pattern>/match</url-pattern>
    </servlet-mapping>

    <!-- API JSON -->
    <servlet>
        <servlet-name>ApiRunnerServlet</servlet-name>
        <servlet-class>com.pacemate.servlet.ApiRunnerServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ApiRunnerServlet</servlet-name>
        <url-pattern>/api/runners</url-pattern>
    </servlet-mapping>

    <!-- Page d'erreur -->
    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/views/error/404.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/WEB-INF/views/error/500.jsp</location>
    </error-page>

    <!-- Session timeout : 30 minutes -->
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
        </cookie-config>
    </session-config>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>
</web-app>
